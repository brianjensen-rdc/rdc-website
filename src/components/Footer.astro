---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="wordmark-red">RED DOOR</span><span class="wordmark-white">COLLABORATIVE</span>
      <p>Where creativity &amp; strategy unite.</p>
    </div>

    <nav aria-label="Footer" class="footer-nav">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/services">Services</a>
      <a href="/work">Work</a>
      <a href="/careers">Careers</a>
      <a href="/contact">Contact</a>
    </nav>

    <div class="footer-offices">
      <div>
        <strong>Washington</strong>
        <p>2018 156th Ave NE, Suite 100<br />Bellevue, WA 98007</p>
      </div>
      <div>
        <strong>California</strong>
        <p>701 Palomar Airport Rd, Suite 300<br />Carlsbad, CA 92011</p>
      </div>
      <p><a href="tel:+17196226141">(719) 622-6141</a></p>
    </div>

    <div class="footer-social">
      <a href="https://www.linkedin.com/company/red-door-collaborative" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://www.instagram.com/reddoorcollaborative" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="https://www.facebook.com/RedDoorCollaborative" target="_blank" rel="noopener noreferrer">Facebook</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {year} Red Door Collaborative, LLC. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
    padding-top: 3.5rem;
    background: var(--color-bg-raised);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.2fr 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .footer-brand .wordmark-red { color: var(--color-red-bright); font-weight: 800; font-family: var(--font-heading); }
  .footer-brand .wordmark-white { color: var(--color-white); font-weight: 800; font-family: var(--font-heading); margin-left: 0.35rem; font-size: 0.85rem; letter-spacing: 0.1em; }
  .footer-brand p { margin-top: 0.75rem; font-size: 0.9rem; }
  .footer-nav { display: flex; flex-direction: column; gap: 0.6rem; }
  .footer-nav a { font-size: 0.9rem; color: var(--color-text-muted); }
  .footer-nav a:hover { color: var(--color-white); }
  .footer-offices strong { color: var(--color-white); font-size: 0.85rem; }
  .footer-offices p { font-size: 0.85rem; margin: 0.3rem 0 1rem; }
  .footer-social { display: flex; flex-direction: column; gap: 0.6rem; align-items: flex-start; }
  .footer-social a { font-size: 0.9rem; color: var(--color-text-muted); }
  .footer-social a:hover { color: var(--color-red-bright); }
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 0;
  }
  .footer-bottom p { font-size: 0.8rem; margin: 0; }
  @media (max-width: 900px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
