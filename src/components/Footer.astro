---
const year = new Date().getFullYear();
const BASE = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src={`${BASE}logo/rdc-logo-light.svg`} alt="Red Door Collaborative" width="170" height="46" class="footer-logo-img" />
      <p>Where creativity &amp; strategy unite.</p>
    </div>

    <nav aria-label="Footer" class="footer-nav">
      <a href={BASE}>Home</a>
      <a href={`${BASE}about/`}>About</a>
      <a href={`${BASE}services/`}>Services</a>
      <a href={`${BASE}work/`}>Work</a>
      <a href={`${BASE}careers/`}>Careers</a>
      <a href={`${BASE}contact/`}>Contact</a>
    </nav>

    <div class="footer-offices">
      <div>
        <strong>Washington</strong>
        <p>2018 156th Ave NE, Suite 100<br />Bellevue, WA 98007</p>
      </div>
      <div>
        <strong>California</strong>
        <p>701 Palomar Airport Rd, Suite 300<br />Carlsbad, CA 92011</p>
      </div>
      <p><a href="tel:+17196226141">(719) 622-6141</a></p>
    </div>

    <div class="footer-social">
      <a href="https://www.linkedin.com/company/red-door-collaborative" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://www.instagram.com/reddoorcollaborative" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="https://www.facebook.com/RedDoorCollaborative" target="_blank" rel="noopener noreferrer">Facebook</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {year} Red Door Collaborative, LLC. All rights reserved.</p>
  </div>
</footer>

<style>
  /* Site footer: Squid per the design system's SiteFooter. Footer nav links
     are not underlined; social and contact links stay underlined. */
  .site-footer {
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    background: var(--squid);
    color: var(--on-dark-body);
    font-size: 14px;
  }
  .site-footer p { color: var(--on-dark-body); }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.2fr 1fr;
    gap: var(--space-10);
    padding-bottom: var(--space-10);
  }
  .footer-logo-img { height: 32px; width: auto; display: block; }
  .footer-brand p { margin-top: var(--space-3); font-size: 15px; }
  .footer-nav { display: flex; flex-direction: column; gap: var(--space-2); }
  .footer-nav a { font-size: 15px; font-weight: 600; color: var(--on-dark-strong); }
  .footer-nav a:hover { color: var(--coral); }
  .footer-offices strong { color: var(--white); font-size: 14px; font-weight: 600; }
  .footer-offices p { font-size: 14px; margin: var(--space-1) 0 var(--space-4); }
  .footer-offices a,
  .footer-social a {
    color: var(--on-dark-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .footer-social { display: flex; flex-direction: column; gap: var(--space-2); align-items: flex-start; }
  .footer-social a { font-size: 15px; }
  .footer-offices a:hover,
  .footer-social a:hover { color: var(--coral); }
  .footer-bottom {
    border-top: 1px solid var(--on-dark-border);
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }
  .footer-bottom p { font-size: 12px; margin: 0; color: rgba(255, 255, 255, 0.6); }
  @media (max-width: 900px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 768px) {
    .site-footer { font-size: 13px; }
    .footer-brand p, .footer-nav a, .footer-social a { font-size: 14px; }
    .footer-offices p, .footer-offices strong { font-size: 13px; }
  }
  @media (max-width: 560px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
