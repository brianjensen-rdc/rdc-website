---
interface Props {
  heading?: string;
}
const { heading = "Let's collaborate." } = Astro.props;
const BASE = import.meta.env.BASE_URL;
---
<section class="cta-section">
  <div class="container cta-inner">
    <h2>{heading}</h2>
    <div class="cta-row">
      <a href={`${BASE}contact/`} class="btn btn-primary-inverted">Hire us</a>
      <a href={`${BASE}careers/`} class="btn btn-outline-inverted">Join us</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: var(--gradient-brand);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .cta-inner h2 { color: var(--color-white); }
  .btn-primary-inverted {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    background: var(--color-white);
    color: var(--color-wine);
    transition: transform 0.15s ease;
  }
  .btn-primary-inverted:hover { transform: translateY(-1px); }
  .btn-outline-inverted {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.6);
    color: var(--color-white);
    transition: border-color 0.15s ease;
  }
  .btn-outline-inverted:hover { border-color: var(--color-white); }
</style>
