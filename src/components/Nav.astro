---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Work' },
  { href: '/careers', label: 'Careers' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---
<header class="site-nav">
  <div class="container nav-inner">
    <a href="/" class="wordmark" aria-label="Red Door Collaborative home">
      <span class="wordmark-red">RED DOOR</span><span class="wordmark-white">COLLABORATIVE</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="/contact" class="btn btn-primary nav-cta">Hire us</a>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(12, 12, 14, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-heading);
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .wordmark-red { color: var(--color-red-bright); font-size: 0.95rem; }
  .wordmark-white { color: var(--color-white); font-size: 0.72rem; letter-spacing: 0.18em; }
  nav ul {
    list-style: none;
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }
  nav a:hover, nav a[aria-current="page"] { color: var(--color-white); }
  .nav-cta { padding: 0.6rem 1.2rem; font-size: 0.88rem; }
  @media (max-width: 800px) {
    nav { display: none; }
  }
</style>
