---
const BASE = import.meta.env.BASE_URL;
const navLinks = [
  { path: '', label: 'Home' },
  { path: 'about/', label: 'About' },
  { path: 'services/', label: 'Services' },
  { path: 'work/', label: 'Work' },
  { path: 'careers/', label: 'Careers' },
  { path: 'contact/', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---
<header class="site-nav">
  <div class="container nav-inner">
    <a href={BASE} class="brand-logo" aria-label="Red Door Collaborative home">
      <img src={`${BASE}logo/rdc-logo-light.svg`} alt="Red Door Collaborative" width="170" height="46" />
    </a>
    <nav aria-label="Primary">
      <ul>
        {navLinks.map((link) => {
          const href = `${BASE}${link.path}`;
          return (
            <li>
              <a
                href={href}
                aria-current={currentPath === href ? 'page' : undefined}
              >{link.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>
    <a href={`${BASE}contact/`} class="btn btn-primary btn-sm nav-cta">Hire us</a>
  </div>
</header>

<style>
  /* Site header: Squid bar per the design system's SiteHeader. Nav links are
     not underlined (Web section); the current page gets a Coral bottom border. */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--squid);
    border-bottom: 1px solid var(--on-dark-border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }
  .brand-logo {
    display: flex;
    align-items: center;
  }
  .brand-logo img {
    height: 34px;
    width: auto;
    display: block;
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-block;
    font-size: 15px;
    font-weight: 600;
    padding: 4px 0;
    color: var(--on-dark-strong);
    border-bottom: 2px solid transparent;
  }
  nav a:hover { color: var(--white); }
  nav a[aria-current="page"] { color: var(--white); border-bottom-color: var(--coral); }
  @media (max-width: 800px) {
    nav { display: none; }
  }
</style>
