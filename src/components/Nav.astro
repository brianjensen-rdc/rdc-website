---
const BASE = import.meta.env.BASE_URL;
const navLinks = [
  { path: '', label: 'Home' },
  { path: 'about/', label: 'About' },
  { path: 'services/', label: 'Services' },
  { path: 'work/', label: 'Work' },
  { path: 'careers/', label: 'Careers' },
  { path: 'contact/', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---
<header class="site-nav" data-site-nav>
  <div class="container nav-inner">
    <a href={BASE} class="brand-logo" aria-label="Red Door Collaborative home">
      <img src={`${BASE}logo/rdc-logo-horizontal-outline-white.svg`} alt="Red Door Collaborative" width="197" height="28" />
    </a>
    <nav aria-label="Primary" id="site-menu">
      <ul>
        {navLinks.map((link) => {
          const href = `${BASE}${link.path}`;
          return (
            <li>
              <a
                href={href}
                aria-current={currentPath === href ? 'page' : undefined}
              >{link.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>
    <a href={`${BASE}contact/`} class="btn btn-primary btn-sm nav-cta">Hire us</a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-menu" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  // Mobile menu toggle (design system SiteHeader pattern).
  const header = document.querySelector('[data-site-nav]');
  const btn = header?.querySelector('.menu-btn');
  const setOpen = (open) => {
    header?.classList.toggle('is-open', open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  btn?.addEventListener('click', () => setOpen(!header?.classList.contains('is-open')));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  window.matchMedia('(min-width: 801px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>

<style>
  /* Site header: Squid bar per the design system's SiteHeader. Nav links are
     not underlined (Web section); the current page gets a Coral bottom border. */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--squid);
    border-bottom: 1px solid var(--on-dark-border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }
  .brand-logo {
    display: flex;
    align-items: center;
  }
  .brand-logo img {
    height: 28px;
    width: auto;
    display: block;
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-block;
    font-size: 15px;
    font-weight: 600;
    padding: 4px 0;
    color: var(--on-dark-strong);
    border-bottom: 2px solid transparent;
  }
  nav a:hover { color: var(--white); }
  nav a[aria-current="page"] { color: var(--white); border-bottom-color: var(--coral); }
  .menu-btn {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    cursor: pointer;
    flex-direction: column;
    gap: 4px;
  }
  .menu-btn span { display: block; width: 22px; height: 2px; background: var(--white); border-radius: 1px; transition: transform 0.15s ease, opacity 0.15s ease; }
  .is-open .menu-btn span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .is-open .menu-btn span:nth-child(2) { opacity: 0; }
  .is-open .menu-btn span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  @media (max-width: 800px) {
    .nav-inner { flex-wrap: wrap; }
    .nav-cta { display: none; }
    .menu-btn { display: flex; order: 2; }
    nav { display: none; flex-basis: 100%; order: 3; }
    .is-open nav { display: block; padding: var(--space-2) 0 var(--space-4); }
    .is-open nav ul { flex-direction: column; gap: var(--space-4); }
    nav a { font-size: 16px; }
  }
</style>
