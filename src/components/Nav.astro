---
const BASE = import.meta.env.BASE_URL;
const navLinks = [
  { path: '', label: 'Home' },
  { path: 'about/', label: 'About' },
  { path: 'services/', label: 'Services' },
  { path: 'work/', label: 'Work' },
  { path: 'careers/', label: 'Careers' },
  { path: 'contact/', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---
<header class="site-nav">
  <div class="container nav-inner">
    <a href={BASE} class="brand-logo" aria-label="Red Door Collaborative home">
      <img src={`${BASE}logo/rdc-logo-light.svg`} alt="Red Door Collaborative" width="170" height="46" />
    </a>
    <nav aria-label="Primary">
      <ul>
        {navLinks.map((link) => {
          const href = `${BASE}${link.path}`;
          return (
            <li>
              <a
                href={href}
                aria-current={currentPath === href ? 'page' : undefined}
              >{link.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>
    <a href={`${BASE}contact/`} class="btn btn-primary nav-cta">Hire us</a>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(13, 23, 36, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .brand-logo {
    display: flex;
    align-items: center;
  }
  .brand-logo img {
    height: 34px;
    width: auto;
    display: block;
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }
  nav a:hover, nav a[aria-current="page"] { color: var(--color-white); }
  .nav-cta { padding: 0.6rem 1.2rem; font-size: 0.88rem; }
  @media (max-width: 800px) {
    nav { display: none; }
  }
</style>
