---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import { Image } from 'astro:assets';
import valuesArt from '../media/careers/values.png';
import remoteWork from '../media/careers/remote-work.png';
import mbeBadge from '../media/careers/minority-business-badge.png';

const values = [
  { title: 'Responsive', copy: 'Our commitment is to provide you with timely communication and feedback during the recruitment process.' },
  { title: 'Human', copy: "We're real people who value being treated with dignity and respect - and we believe the Golden Rule still applies." },
  { title: 'Relational', copy: "We're about building long-term relationships rather than just filling positions." },
  { title: 'Collaborative', copy: 'We do our best work when partnering with you to find the right match for your unique skills and goals.' },
];

const benefits = [
  { title: 'PTO', copy: 'Every employee receives accrued paid time off - starting at two weeks per year - to rest and recharge.' },
  { title: 'Sick and safe leave', copy: 'For when you need to take care of yourself.' },
  { title: '401K', copy: 'Available and fully vested with employee match after 90 days.' },
  { title: 'Insurance', copy: 'Choose from several competitive medical, dental, and vision plans, as well as available FSA and HSA options.' },
  { title: 'Miscellaneous', copy: 'Additional benefits to make your hybrid/remote setup environment comfortable and productive.' },
];
---
<Layout title="Careers" description="Join Red Door Collaborative - a fully remote, minority-owned creative agency built on responsive, human, relational, and collaborative values.">
  <section class="hero tight">
    <div class="container">
      <span class="eyebrow">Careers</span>
      <h1>Come work with us.</h1>
      <p class="hero-sub">We believe people are motivated to be part of something larger than they are. Come see what you can do with us.</p>
      <div class="cta-row">
        <a href="https://www.careers-page.com/red-door-collaborative" class="btn btn-primary" target="_blank" rel="noopener noreferrer">See current openings</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <span class="eyebrow">What we value</span>
      <h2>How we show up for candidates.</h2>
      <div class="media-split values-split" style="margin-top: 2.5rem;">
        <Image src={valuesArt} alt="Illustration of people, a heart, and conversation shapes" widths={[368, 736]} width={736} sizes="(max-width: 900px) 80vw, 480px" />
        <div class="grid grid-2">
          {values.map((v) => (
            <div class="card">
              <h3>{v.title}</h3>
              <p>{v.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="container two-col">
      <div>
        <Image src={remoteWork} alt="Illustration of a remote team connected across locations" class="two-col-media" widths={[640, 1280]} width={1280} sizes="(max-width: 800px) 92vw, 600px" />
        <span class="eyebrow">How we work</span>
        <h2>Fully remote, globally sourced.</h2>
        <p>As a fully remote company, we get to draw from a deep well of applications to work on exciting projects all over the world. Many of our roles are remote, while some may require you to be on-site with clients.</p>
      </div>
      <div>
        <Image src={mbeBadge} alt="NMSDC certified Minority Business Enterprise badge" class="two-col-media" widths={[640, 1280]} width={1280} sizes="(max-width: 800px) 92vw, 600px" />
        <span class="eyebrow">Who we are</span>
        <h2>Diversity is our foundation.</h2>
        <p>For us diversity isn't just a belief or concept, it is the core of our business. As a minority-owned company, we believe our organization succeeds when we embrace the full range of what it means to be human.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <span class="eyebrow">We take care of you</span>
      <h2>Benefits.</h2>
      <p>We take care of our employees so they can take care of our clients. Our roles offer competitive salaries and benefits.</p>
      <table class="benefits" style="margin-top: 1.5rem; width: 100%; border-collapse: collapse;">
        {benefits.map((b) => (
          <tr>
            <td>{b.title}</td>
            <td>{b.copy}</td>
          </tr>
        ))}
      </table>
    </div>
  </section>

  <section class="tight">
    <div class="container">
      <blockquote class="quote">
        Everyone on a project offers a unique perspective; we celebrate that. And when we collaborate, we're enabled to create the best products possible.
      </blockquote>
      <p class="quote-attribution">Joy Baer, Senior Lead Visual Designer</p>
    </div>
  </section>

  <CTASection heading="Don't see what you're looking for? Reach out anyway." />
</Layout>

<style>
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
  .two-col-media { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: contain; background: var(--surface); border-radius: var(--radius-2xl); margin-bottom: var(--space-6); }
  .values-split { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
  .values-split img { border-radius: 0; }
  @media (max-width: 800px) {
    .two-col { grid-template-columns: 1fr; }
  }
  @media (max-width: 900px) {
    .values-split { grid-template-columns: 1fr; }
    .values-split img { max-width: 360px; margin: 0 auto; }
  }
</style>
