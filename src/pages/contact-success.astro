---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thanks for reaching out">
  <section class="hero tight">
    <div class="container" style="text-align:center;">
      <span class="eyebrow">Message sent</span>
      <h1>Thanks &mdash; we'll be in touch.</h1>
      <p class="hero-sub" style="margin: 0 auto;">Someone from the Red Door Collaborative team will follow up shortly.</p>
      <div class="cta-row" style="justify-content:center; margin-top: 1.5rem;">
        <a href="/" class="btn btn-outline">Back to home</a>
      </div>
    </div>
  </section>
</Layout>
