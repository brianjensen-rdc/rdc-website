---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import { Image } from 'astro:assets';
import infinityChart from '../media/home/infinity-chart.png';
import microsoft from '../media/clients/microsoft.png';
import salesforce from '../media/clients/salesforce.png';
import databricks from '../media/clients/databricks.png';
import procraft from '../media/clients/procraft.png';
import meta from '../media/clients/meta.png';
import thumbAzure from '../media/work/azure-essentials.png';
import thumbVss from '../media/work/vss-benefits.png';
import thumbProcraft from '../media/work/procraft.png';

const BASE = import.meta.env.BASE_URL;
const clients = [
  { name: 'Microsoft', logo: microsoft },
  { name: 'Salesforce', logo: salesforce },
  { name: 'Databricks', logo: databricks },
  { name: 'Procraft', logo: procraft },
  { name: 'Meta', logo: meta },
];

const caseStudies = [
  {
    name: 'Azure Essentials',
    client: 'Microsoft',
    services: 'Brand strategy, digital, content, social, video, design, events',
    href: 'case-study-azure-essentials/',
    image: thumbAzure,
    alt: 'Isometric cloud illustration from the Azure Essentials campaign',
  },
  {
    name: 'Visual Studio Subscriptions Benefits',
    client: 'Microsoft',
    services: 'Digital, content, social, video, graphic design, events',
    href: 'case-study-vss-benefits/',
    image: thumbVss,
    alt: 'Glowing laptop illustration from the Visual Studio Subscriptions campaign',
  },
  {
    name: 'Procraft Digital Course',
    client: 'Procraft',
    services: 'Brand strategy, content, video production, graphic design',
    href: 'case-study-procraft/',
    image: thumbProcraft,
    alt: 'Sound board illustration from the Procraft digital course',
  },
];
---
<Layout title="Home">
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow hero-eyebrow">Creative &amp; Strategy Agency</span>
        <h1 class="display">Where creativity &amp; strategy unite.</h1>
        <p class="hero-sub">Marketing that speaks your brand's language and drives real engagement - from an embedded team that works the way yours does.</p>
        <div class="cta-row">
          <a href={`${BASE}contact/`} class="btn btn-primary">Hire us</a>
          <a href={`${BASE}careers/`} class="btn btn-outline">Join us</a>
        </div>
      </div>
      <img class="hero-mark" src={`${BASE}logo/rdc-secondary-icon-full-color.svg`} alt="" aria-hidden="true" width="443" height="400" />
    </div>
  </section>

  <section class="tight">
    <div class="container">
      <p class="social-proof-label">We've collaborated with some of the biggest names in tech.</p>
      <div class="logo-wall">
        {clients.map((c) => <Image src={c.logo} alt={`${c.name} logo`} widths={[268, 536]} width={536} sizes="(max-width: 560px) 45vw, (max-width: 900px) 30vw, 240px" />)}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <span class="eyebrow">What we do</span>
      <h2>Let's see what we can do together.</h2>
      <Image src={infinityChart} alt="Consulting services and marketing services shown as two connected loops" class="infinity-chart" widths={[640, 960, 1280]} width={1280} sizes="(max-width: 1000px) 92vw, 960px" />
      <div class="grid grid-3" style="margin-top: 2.5rem;">
        <div class="card">
          <h3>Consulting</h3>
          <p>Embedded, project-based, and managed-services consulting that scales your team with the right people, fast.</p>
        </div>
        <div class="card">
          <h3>Marketing</h3>
          <p>Branding, digital, content, social, design, video, and event marketing - built as an extension of your brand.</p>
        </div>
        <div class="card">
          <h3>Production</h3>
          <p>From concept to launch, we staff the specialists who take a campaign from idea to finished, measurable work.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <span class="eyebrow">Our work</span>
      <h2>Marketing brilliance that speaks for itself.</h2>
      <div class="grid grid-3" style="margin-top: 2.5rem;">
        {caseStudies.map((cs) => (
          <a class="card case-card" href={`${BASE}${cs.href}`}>
            <Image src={cs.image} alt={cs.alt} class="card-media" widths={[400, 800]} width={800} sizes="(max-width: 900px) 92vw, 400px" />
            <h3>{cs.name}</h3>
            <p class="case-client">{cs.client}</p>
            <p class="case-services">{cs.services}</p>
          </a>
        ))}
      </div>
      <div style="margin-top: 2.5rem;">
        <a href={`${BASE}work/`} class="btn btn-outline">See all of our work</a>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="container">
      <blockquote class="quote">
        "It all begins with an idea&nbsp; -  the way you tell your story online can make all the difference."
      </blockquote>
      <p class="quote-attribution">Chris Telfer, Managing Partner &amp; Creative Director</p>
    </div>
  </section>

  <CTASection />
</Layout>

<style>
  .hero { padding: var(--space-24) 0 var(--space-20); }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-12);
  }
  .hero-copy { max-width: 760px; }
  /* Secondary icon as the hero graphic (Web section): Coral, 120px tall or larger. */
  .hero-mark { height: clamp(240px, 28vw, 400px); width: auto; display: block; }
  .hero-eyebrow { color: var(--text-muted); }
  .hero-sub { margin-bottom: var(--space-8); }
  .social-proof-label {
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-8);
  }
  .case-client { color: var(--accent-text); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; }
  .case-services { font-size: 15px; }
  .infinity-chart { display: block; width: 100%; max-width: 960px; height: auto; margin: var(--space-8) auto 0; border-radius: var(--radius-2xl); }
  .case-card { display: block; transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease; }
  .case-card:hover { border-color: var(--border-strong); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-mark { display: none; }
  }
  @media (max-width: 768px) {
    .case-services { font-size: 14px; }
    .social-proof-label, .case-client { font-size: 11px; }
  }
</style>
